{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCP Memory Viewer",
  "version": "0.1.0",
  "identifier": "ar.com.pco.mcpviewer",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/viewer/browser"
  },
  "app": {
    "windows": [
      {
        "title": "MCP Memory Viewer",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
